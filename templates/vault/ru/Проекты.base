filters:
  and:
    - file.inFolder("Проекты")
views:
  - type: table
    name: Все
    order:
      - file.name
      - project
      - status
      - updated
      - next
    sort:
      - property: updated
        direction: DESC
  - type: table
    name: Ждёт владельца
    filters:
      and:
        - status == "ждёт владельца"
    order:
      - file.name
      - project
      - updated
      - next
